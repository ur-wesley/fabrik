{
  "name": "@ur-wesley/fabrik",
  "version": "1.0.0",
  "description": "Fabrik: Scoped session orchestrator, low-token YAML config, RTK token compression, and task workflow extension for Pi Agent (pi.dev)",
  "main": "index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi.dev",
    "ai-agent",
    "workflow",
    "rtk",
    "engram"
  ],
  "scripts": {
    "test": "bun test ./src",
    "test:e2e": "bun test ./e2e/*.e2e.test.ts",
    "test:all": "bun test ./src && bun test ./e2e/*.e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint src",
    "lint:fix": "bunx oxlint --fix src && bunx oxfmt src",
    "format": "bunx oxfmt src",
    "cli:test": "cd cli; go test ./...",
    "cli:build": "cd cli; go build -trimpath -o fabrik ./cmd/fabrik",
    "cli:version": "node -p \"require('./cli/package.json').version\""
  },
  "dependencies": {
    "@ur-wesley/ts-prelude": "latest",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0"
  }
}

